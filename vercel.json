{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "thenameisbhagavan.vercel.app"
        }
      ],
      "destination": "https://thenameisbhagavan.in/$1",
      "permanent": true
    },
    { "source": "/projects", "destination": "/work", "permanent": true },
    { "source": "/skills", "destination": "/ecosystem", "permanent": true },
    { "source": "/contact", "destination": "/connect", "permanent": true },
    { "source": "/home", "destination": "/overview", "permanent": true },
    { "source": "/insights", "destination": "/journal", "permanent": true },
    { "source": "/insights/(.*)", "destination": "/journal/$1", "permanent": true },
    { "source": "/engineering-journal", "destination": "/journal", "permanent": true },
    { "source": "/engineering-journal/(.*)", "destination": "/journal/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
