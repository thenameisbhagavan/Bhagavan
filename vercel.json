{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects", "destination": "/work", "permanent": true },
    { "source": "/skills", "destination": "/ecosystem", "permanent": true },
    { "source": "/contact", "destination": "/connect", "permanent": true },
    { "source": "/home", "destination": "/overview", "permanent": true }
  ],
  "rewrites": [
    { "source": "/work/voltdrive", "destination": "/index.html" },
    { "source": "/work/careeros", "destination": "/index.html" },
    { "source": "/work/auraos", "destination": "/index.html" },
    { "source": "/work/veritas", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/insights/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
